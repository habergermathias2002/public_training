# ==============================================================================
# Training Brain & AI Cloud Coach – Umgebungsvariablen (.env)
# Kopiere diese Datei nach .env und fülle deine eigenen Keys aus.
# WICHTIG: Die echte .env steht in .gitignore und darf NIEMALS committet werden!
# ==============================================================================

# --- 1. Supabase (Datenbank für die lokale Web-App) ---
# Werte aus dem Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- 2. Gemini API (AI Cloud Coach) ---
# Key erzeugen unter https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional: bevorzugtes Gemini-Modell überschreiben (Standard: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# --- 3. Google Apps Script Bridge (Google Calendar & Gmail) ---
# Setup-Anleitung siehe README.md und cloud/google_bridge.gs
GOOGLE_BRIDGE_URL=https://script.google.com/macros/s/your-deployment-id/exec
GOOGLE_BRIDGE_SECRET=your-long-random-bridge-secret

# --- 4. Athleten-Konfiguration ---
# Zieladresse für tägliche Briefings (muss bei Bedarf mit Google Bridge übereinstimmen)
COACH_RECIPIENT_EMAIL=you@example.com
# Anzeigename für den AI-Coach-Prompt
ATHLETE_NAME=Alex
# Zeitzonen-Offset für Google Calendar Events (z. B. +01:00 im Winter, +02:00 im Sommer)
COACH_TZ_OFFSET=+01:00

# --- 5. Optional: Garmin Personal API Key ---
# Lokal wird der Key bevorzugt aus api_key.txt (chmod 600) oder dem macOS-Schlüsselbund gelesen.
# In GitHub Actions wird GARMIN_API_KEY als Repository Secret gesetzt.
# GARMIN_API_KEY=your-garmin-personal-api-key
